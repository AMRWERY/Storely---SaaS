{
  "name": "storely",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:merchant": "pnpm --filter merchant dev",
    "dev:marketing": "pnpm --filter marketing dev",
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:platform-admin": "pnpm --filter platform-admin dev",
    "build:merchant": "pnpm --filter merchant build",
    "build:marketing": "pnpm --filter marketing build",
    "build:storefront": "pnpm --filter storefront build",
    "build:platform-admin": "pnpm --filter platform-admin build"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
